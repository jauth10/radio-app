# Build output (matches every module: /build, /app/build, ...)
build/
captures/
.externalNativeBuild
.cxx

# Gradle / Kotlin local state
.gradle
.kotlin

# Machine-specific — contains the local Android SDK path
local.properties

# Signing / secrets
*.jks
*.keystore
keystore.properties
secrets.properties

# OS
.DS_Store

# IDE: shared project config IS committed (gradle.xml, misc.xml, compiler.xml,
# runConfigurations.xml, inspectionProfiles/, vcs.xml).
# Only per-developer state is ignored:
*.iml
.idea/workspace.xml
.idea/shelf/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/deviceManager.xml
.idea/androidTestResultsUserPreferences.xml
.idea/markdown.xml
# Regenerated from Gradle on every sync and would duplicate the Kotlin version
# that gradle/libs.versions.toml already owns.
.idea/kotlinc.xml
